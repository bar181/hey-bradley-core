          "props": {
            "icon": "shield",
            "title": "The Engineering of Trust",
            "description": "What it actually takes to ship AI systems your customers — and your regulators — will tolerate. Drawn from the failed deployments nobody publishes. 45- or 60-minute formats. Best for: enterprise summits, board offsites, cabinet briefings."
          }
        },
        {
          "id": "topic-2",
          "type": "feature-card",
          "enabled": true,
          "order": 1,
          "props": {
            "icon": "brain",
            "title": "Machine Cognition Without the Hype",
            "description": "A working framework for what large models do, what they cannot do, and the seven categories of executive decision they should never be allowed near. Field-tested on 12,000+ enterprise audiences."
          }
        },
        {
          "id": "topic-3",
          "type": "feature-card",
          "enabled": true,
          "order": 2,
          "props": {
            "icon": "compass",
            "title": "The Decade Ahead in Responsible AI",
            "description": "A research-grounded forecast covering policy, infrastructure, and the cultural questions every leadership team will be asked between now and 2035. Includes interactive Q&A that organizers consistently rate the high point of the day."
          }
        }
      ],
      "content": {
        "heading": "Three Signature Talks",
        "subheading": "Choose the closest fit; every keynote is then re-tailored to your specific audience and theme"
