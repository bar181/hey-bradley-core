      "components": [
        {
          "id": "f-1",
          "type": "feature-card",
          "enabled": true,
          "order": 0,
          "props": {
            "icon": "shield",
            "title": "Typed schemas",
            "description": "Declare your config in TypeScript, JSON Schema, or Zod. The runtime enforces types at process boot and refuses to start if a required key is missing or malformed. No more 'undefined is not a function' from a missing env var."
          }
        },
        {
          "id": "f-2",
          "type": "feature-card",
          "enabled": true,
          "order": 1,
          "props": {
            "icon": "refresh",
            "title": "Hot-reload across services",
            "description": "Change a feature flag in the control plane; every connected service receives the typed update within 200ms. No restart. No connection churn. Atomic per-service via copy-on-write snapshots."
          }
        },
        {
          "id": "f-3",
          "type": "feature-card",
          "enabled": true,
          "order": 2,
          "props": {
            "icon": "git-branch",
            "title": "Audit-grade history",
            "description": "Every config change is a content-addressed commit. Diff against any prior state, attribute to an actor, replay in staging. SOC 2 evidence trail without a separate tool."
          }
        }
      ],
      "content": {
        "heading": "Three primitives, zero surprises",
        "subheading": "Typed at the boundary, enforced at runtime, audited end-to-end"
      }
    },
