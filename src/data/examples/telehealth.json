          "enabled": true,
          "order": 0,
          "props": {
            "icon": "zap",
            "title": "Instant Access, 24/7",
            "description": "Median time from request to clinician is 12 minutes. Overnight, weekends, holidays — same staffing, same response time. No appointment-booking dance."
