        },
        {
          "id": "f-2",
          "type": "feature-card",
          "enabled": true,
          "order": 1,
          "props": {
            "icon": "home",
            "title": "Skip the Commute",
            "description": "Visits happen on your phone or laptop in plain English. Prescriptions go straight to your pharmacy. Lab orders go to the nearest LabCorp or Quest. Done in 20 minutes."
          }
        },
        {
          "id": "f-3",
          "type": "feature-card",
          "enabled": true,
          "order": 2,
          "props": {
            "icon": "shield",
