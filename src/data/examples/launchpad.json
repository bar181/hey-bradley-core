        {
          "id": "f1",
          "type": "feature-card",
          "enabled": true,
          "order": 0,
          "props": {
            "icon": "git-branch",
            "title": "Multi-agent orchestration",
            "description": "Compose agents in declarative YAML. Branch, parallelize, retry, and gate steps with deterministic semantics. Sub-agent calls show up as nested spans in tracing — no more guessing which agent stalled."
          }
        },
        {
          "id": "f2",
          "type": "feature-card",
          "enabled": true,
          "order": 1,
          "props": {
            "icon": "rewind",
            "title": "Deterministic replay",
            "description": "Every production run is recorded with seeded RNG, frozen tool I/O, and exact prompts. Replay any failed run locally — `lp replay run_42a` — and catch regressions in CI before they hit users."
          }
        },
        {
          "id": "f3",
          "type": "feature-card",
          "enabled": true,
          "order": 2,
          "props": {
            "icon": "activity",
            "title": "Per-step observability",
            "description": "Token counts, tool latency, cost, and verdicts on every agent step. Filter by user, by run, by failed evals. Alerts fire on cost spikes and drift in tool-call distributions, not just hard errors."
          }
        }
      ],
      "content": {
        "heading": "Built for teams running agents in production",
        "subheading": "The three primitives every ML platform team rebuilds — done once, done right"
      }
    },
