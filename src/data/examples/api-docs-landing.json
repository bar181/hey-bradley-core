          "id": "c-1",
          "type": "feature-card",
          "enabled": true,
          "order": 0,
          "props": {
            "icon": "broadcast",
            "title": "Pub / Sub",
            "description": "Wildcard channels, per-subscriber filters, ordered delivery, exactly-once semantics behind a feature flag. Fan-out tested to 1.2M concurrent subscribers per channel; we have the load-test logs and we'll show you."
          }
        },
        {
          "id": "c-2",
          "type": "feature-card",
          "enabled": true,
          "order": 1,
          "props": {
            "icon": "users",
            "title": "Presence",
            "description": "Track who's online per channel with typed metadata. Heartbeats are managed for you; clients drop cleanly on network failure within 4 seconds. Build cursors, typing indicators, and live dashboards without inventing them again."
          }
        },
        {
          "id": "c-3",
          "type": "feature-card",
          "enabled": true,
          "order": 2,
          "props": {
            "icon": "history",
            "title": "Replayable history",
            "description": "Every channel has 7 days of replayable history out of the box, paginated by message ID or timestamp. Late-joiners catch up. Disconnects don't lose state. Audit trails are built-in, not bolted on."
          }
        }
      ],
      "content": {
        "heading": "Three capabilities, one API surface",
        "subheading": "What every realtime feature in your backlog actually needs"
      }
