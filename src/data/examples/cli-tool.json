      "components": [
        {
          "id": "f-1",
          "type": "feature-card",
          "enabled": true,
          "order": 0,
          "props": {
            "icon": "zap",
            "title": "Instant cache",
            "description": "Persistent on-disk module cache keyed by content hash + tsconfig digest. Re-builds in 80-140ms regardless of project size. Cache survives branch switches; never re-builds an unchanged module twice."
          }
        },
        {
          "id": "f-2",
          "type": "feature-card",
          "enabled": true,
          "order": 1,
          "props": {
            "icon": "puzzle",
            "title": "Plugin API in TS",
            "description": "Write plugins in TypeScript, not Rust. The host runtime exposes a typed AsyncIterator of build events; your plugin returns transform results or null. Compatible with the Rollup plugin contract for 80% of common patterns."
          }
        },
        {
          "id": "f-3",
          "type": "feature-card",
          "enabled": true,
          "order": 2,
          "props": {
            "icon": "code",
            "title": "TS-first, spec-driven",
            "description": "Build pipelines are declared in a single AISP-compatible config that compiles to a deterministic execution plan. <2% ambiguity in spec-to-build round-trips. Pair this with Hey Bradley's spec layer and the same config generates docs, tests, and CI."
          }
        }
      ],
      "content": {
        "heading": "Three reasons it's already in your CI",
        "subheading": "Designed for senior engineers shipping production builds"
      }
    },
