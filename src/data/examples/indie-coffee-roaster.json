        { "id": "team-eyebrow", "type": "badge", "enabled": true, "order": 0, "props": { "text": "two brothers · one drum", "variant": "pill" } },
        { "id": "m1", "type": "team-member", "enabled": true, "order": 1, "props": { "name": "Mateo Vega", "role": "Roaster · co-founder", "image": "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=400&auto=format&q=80", "bio": "Q-grader since 2019. Spent four years at a wholesale roastery in Oakland before opening Switchback with Diego. Believes the cup tells the truth about the soil." } },
        { "id": "m2", "type": "team-member", "enabled": true, "order": 2, "props": { "name": "Diego Vega", "role": "Sourcing · co-founder", "image": "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=400&auto=format&q=80", "bio": "Visits every farm we buy from. Three trips a year — Guatemala in February, Ethiopia in May, Antigua in October. The relationships are the supply chain." } }
      ],
