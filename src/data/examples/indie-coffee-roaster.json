      "layout": { "display": "flex", "direction": "column", "align": "center", "gap": "24px", "padding": "112px 24px 72px", "maxWidth": "1000px" },
      "style": { "background": "#1a0f08", "color": "#f5e6d3" },
      "components": [
        { "id": "eyebrow", "type": "badge", "enabled": true, "order": 0, "props": { "text": "Berkeley · drum-roasted weekdays · ships next morning", "variant": "pill" } },
        { "id": "headline", "type": "heading", "enabled": true, "order": 1, "props": { "text": "Fresh-roasted small-batch coffee for people who actually taste their drink.", "level": 1, "size": "52px", "weight": 700 } },
        { "id": "subtitle", "type": "text", "enabled": true, "order": 2, "props": { "text": "No mystery beans. No aged stock. We roast Tuesday through Friday and ship the next morning. You drink it within the 14-day window when coffee is supposed to be drunk." } },
        { "id": "primaryCta", "type": "button", "enabled": true, "order": 3, "props": { "text": "Get tomorrow's roast.", "url": "#cta", "style": "filled", "size": "lg" } },
        { "id": "secondaryCta", "type": "button", "enabled": true, "order": 4, "props": { "text": "How we roast →", "url": "#article", "style": "outline", "size": "lg" } }
      ],
      "content": {}
    },
    {
      "type": "text",
      "id": "article-roasting-philosophy",
      "enabled": true,
      "order": 1,
      "variant": "long-form",
      "layout": { "display": "flex", "direction": "column", "align": "stretch", "gap": "20px", "padding": "80px 24px", "maxWidth": "780px" },
      "style": { "background": "#2a1810", "color": "#f5e6d3" },
      "components": [
        { "id": "art-eyebrow", "type": "badge", "enabled": true, "order": 0, "props": { "text": "our roasting philosophy", "variant": "pill" } },
        { "id": "art-title", "type": "heading", "enabled": true, "order": 1, "props": { "text": "Drum, not air. Light-medium, not dark. Fourteen days, not ninety.", "level": 2, "size": "36px", "weight": 700 } },
        { "id": "art-body-1", "type": "text", "enabled": true, "order": 2, "props": { "text": "We roast on a 5-kilo drum. Drum roasting is slower than air roasting. It costs us more. We do it anyway because the bean develops sugar and body the way it's supposed to — slow heat, long Maillard, a finish you can taste twenty minutes after you swallow." } },
        { "id": "art-body-2", "type": "text", "enabled": true, "order": 3, "props": { "text": "Light-medium is the only roast on the menu. Dark roast hides defects. We don't have any. The greens come from three farms we've visited — one in Huehuetenango, one in Yirgacheffe, one in Antigua — and the cup tells the truth about the soil. A French roast would burn that information away. We won't do that to you." } },
        { "id": "art-body-3", "type": "text", "enabled": true, "order": 4, "props": { "text": "Fourteen days. That's the window. Seven to ten days post-roast is peak; day fourteen is the line where flavor falls off a cliff. Grocery-store coffee is roasted in March and shelved in October. That bag in your kitchen is dead. Ours arrives at your door the morning after it leaves the drum, and you drink it before it has a chance to forget what it was." } },
        { "id": "art-body-4", "type": "text", "enabled": true, "order": 5, "props": { "text": "That's the whole philosophy. Drum roast the good greens, ship them fast, ask you to drink them on time. No subscriptions you'll forget about. No app. One bag, one week, one cup at a time." } }
      ],
      "content": {}
    },
    {
      "type": "pricing",
      "id": "pricing-01",
      "enabled": true,
      "order": 2,
      "variant": "single-hero",
      "layout": { "display": "flex", "direction": "column", "align": "center", "gap": "24px", "padding": "80px 24px", "maxWidth": "640px" },
      "style": { "background": "#1a0f08", "color": "#f5e6d3" },
      "components": [
        { "id": "price-eyebrow", "type": "badge", "enabled": true, "order": 0, "props": { "text": "one plan · cancel anytime · no app", "variant": "pill" } },
        { "id": "price-title", "type": "heading", "enabled": true, "order": 1, "props": { "text": "One bag. Every month. Thirty-two dollars.", "level": 2, "size": "40px", "weight": 700 } },
        { "id": "price-tier", "type": "pricing-tier", "enabled": true, "order": 2, "props": { "name": "Monthly Bag", "price": "$32", "period": "month", "features": "12 oz drum-roasted bag,Ships first business day of every month,Roasted within 24 hours of shipping,Three-farm rotation (Guatemala / Ethiopia / Antigua),Cancel anytime — one click,Free shipping in continental US", "ctaText": "Get tomorrow's roast.", "ctaUrl": "#cta", "highlighted": true } },
        { "id": "price-fineprint", "type": "text", "enabled": true, "order": 3, "props": { "text": "We don't run a tiered pricing maze. One bag. One price. We tested taster packs and bag-of-the-month clubs — turns out people just want good coffee on a schedule. So that's what we sell." } }
      ],
      "content": {}
    },
