      "components": [
        {
          "id": "body",
          "type": "text",
          "enabled": true,
          "order": 0,
          "props": {
            "body": "Build Mode started in 2024 as a Slack thread between Naveed and Jules — both staff engineers, both annoyed that every AI podcast was either keynote-flavored optimism or doom. We wanted a show for the people writing the actual code: how they think about state, how they evaluate quality, what they're willing to pay per request, what they regret shipping. Forty-seven episodes later, the thread is a podcast and the audience has gotten loud about wanting more of the same. So that's what we keep doing."
          }
        }
      ],
      "content": {
        "heading": "About the show",
        "subheading": "Made by engineers, for engineers, about engineering"
      }
    },
