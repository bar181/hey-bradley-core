{
  "site": {
    "title": "Axon CLI · agentic dependency review at parallel scale",
    "description": "Axon runs 30 parallel review agents per repo. Stop reviewing dependencies one PR at a time. Built for engineering teams who treat code review as a system, not a chore.",
