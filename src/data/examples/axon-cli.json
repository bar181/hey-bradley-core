        { "id": "t-1", "type": "testimonial", "enabled": true, "order": 0, "props": { "quote": "We retired our weekly dependency-review meeting. Axon does it nightly across 84 repos.", "author": "Priya Vasquez", "title": "Eng Manager · Sequent" } },
        { "id": "t-2", "type": "testimonial", "enabled": true, "order": 1, "props": { "quote": "The atomic rollback is the feature that earned our budget approval. Half-applied refactors used to bite us monthly.", "author": "Devon Marsh", "title": "Eng Manager · Glasshouse Labs" } },
        { "id": "t-3", "type": "testimonial", "enabled": true, "order": 2, "props": { "quote": "Forty-seven seconds to scan our monorepo. The previous tool needed forty-seven minutes. Same finding count.", "author": "Yuki Hartman", "title": "Eng Manager · Northpoint Robotics" } }
      ],
      "content": { "heading": "// engineering managers", "subheading": "Three teams who replaced their review meeting with a cron job." }
