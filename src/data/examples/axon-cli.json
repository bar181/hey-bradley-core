            { "id": "d-eyebrow", "type": "badge", "enabled": true, "order": 0, "props": { "text": "// docs · v1.0", "variant": "pill" } },
            { "id": "d-headline", "type": "heading", "enabled": true, "order": 1, "props": { "text": "Axon docs.", "level": 1, "size": "44px", "weight": 700 } },
            { "id": "d-subtitle", "type": "text", "enabled": true, "order": 2, "props": { "text": "Install in one command. Run in two. Read the report in your terminal." } }
