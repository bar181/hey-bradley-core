        {
          "type": "text",
          "id": "docs-getting-started",
          "enabled": true,
          "order": 1,
          "variant": "article",
          "layout": { "display": "flex", "direction": "column", "align": "stretch", "gap": "20px", "padding": "32px 24px 64px", "maxWidth": "820px" },
          "style": { "background": "#0b0a14", "color": "#ece8f5" },
          "components": [
            { "id": "gs-heading", "type": "heading", "enabled": true, "order": 0, "props": { "text": "Getting started", "level": 2, "size": "32px", "weight": 700 } },
            { "id": "gs-p1", "type": "text", "enabled": true, "order": 1, "props": { "text": "Axon is a single binary. Install it via Homebrew on macOS, apt on Debian-derived Linux, or download the static build for Windows. The binary has no runtime dependencies — it bundles the agent runtime, the dependency-graph walker, and the CVE database client." } },
            { "id": "gs-p2", "type": "text", "enabled": true, "order": 2, "props": { "text": "After install, run axon init in any repo. This writes an axon.toml config file with sensible defaults: 10 agents in parallel, OSV as the CVE source, no automated rollback. Edit the file to scale up to 30 agents (Team tier) or unlimited (Enterprise). The config is checked into your repo." } },
            { "id": "gs-p3", "type": "text", "enabled": true, "order": 3, "props": { "text": "Trigger a review with axon run --review. The first run takes longer because Axon caches the dependency graph and the CVE snapshot. Subsequent runs reuse the cache and finish in under a minute for most monorepos. Reports write to ./axon-report.html and to stdout in compact form." } }
          ],
          "content": {}
        },
        {
          "type": "columns",
          "id": "docs-cli-reference",
          "enabled": true,
          "order": 2,
          "variant": "stacked",
          "layout": { "display": "grid", "columns": 1, "gap": "16px", "padding": "32px 24px 64px", "maxWidth": "820px" },
          "style": { "background": "#15131f", "color": "#ece8f5" },
          "components": [
            { "id": "cli-1", "type": "feature-card", "enabled": true, "order": 0, "props": { "icon": "terminal", "title": "axon init", "description": "Write a default axon.toml config file at the repo root. Idempotent — re-running preserves any custom edits." } },
            { "id": "cli-2", "type": "feature-card", "enabled": true, "order": 1, "props": { "icon": "play", "title": "axon run [--review] [--parallel N]", "description": "Execute a review pass. --review enables the full pipeline (deps + CVEs + lint). --parallel N caps agent count (default: 10)." } },
            { "id": "cli-3", "type": "feature-card", "enabled": true, "order": 2, "props": { "icon": "rotate-ccw", "title": "axon rollback [--last]", "description": "Revert the most recent atomic batch. --last is implicit. Pass a snapshot ID to roll back further." } },
            { "id": "cli-4", "type": "feature-card", "enabled": true, "order": 3, "props": { "icon": "search", "title": "axon graph [--depth N]", "description": "Print the resolved dependency graph as JSON. --depth caps transitive walks (default: unbounded)." } },
            { "id": "cli-5", "type": "feature-card", "enabled": true, "order": 4, "props": { "icon": "file-text", "title": "axon report [--format html|json|md]", "description": "Re-emit the most recent report in another format. Useful for piping into Slack or a static site." } }
          ],
          "content": { "heading": "// CLI commands", "subheading": "Five commands. The whole surface area." }
