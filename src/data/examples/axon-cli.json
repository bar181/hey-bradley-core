      "style": { "background": "#0b0a14", "color": "#ece8f5" },
      "components": [
        { "id": "eyebrow", "type": "badge", "enabled": true, "order": 0, "props": { "text": "v1.0 · MIT · 30 agents/repo", "variant": "pill" } },
        { "id": "headline", "type": "heading", "enabled": true, "order": 1, "props": { "text": "Stop reviewing dependencies one PR at a time.", "level": 1, "size": "56px", "weight": 700 } },
        { "id": "subtitle", "type": "text", "enabled": true, "order": 2, "props": { "text": "Axon runs 30 parallel review agents per repo. Each agent owns a slice of the dependency graph. Reports land in minutes, not afternoons." } },
