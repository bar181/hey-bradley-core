        { "id": "ce-heading", "type": "heading", "enabled": true, "order": 1, "props": { "text": "One command. Thirty agents.", "level": 2, "size": "36px", "weight": 700 } },
        { "id": "ce-code", "type": "code", "enabled": true, "order": 2, "props": { "language": "bash", "text": "$ axon run --parallel 30 --review\n  → spawning 30 review agents...\n  → graph walked: 1,847 deps across 12 repos\n  → 7 CVEs surfaced (2 high, 5 medium)\n  → 14 lint failures across 9 files\n  → report ready: ./axon-report.html (2.4 MB)\n  ✓ done in 47s" } },
        { "id": "ce-explainer", "type": "text", "enabled": true, "order": 3, "props": { "text": "The default review fans out across the dependency graph. Pass --serial to fall back to single-agent mode for debugging. Reports are deterministic — same input, same output, same hash." } }
      ],
      "content": {}
