    {
      "type": "columns",
      "id": "features-01",
      "enabled": true,
      "order": 1,
      "variant": "grid",
      "layout": { "display": "grid", "columns": 3, "gap": "24px", "padding": "80px 24px" },
      "style": { "background": "#15131f", "color": "#ece8f5" },
      "components": [
        { "id": "f-1", "type": "feature-card", "enabled": true, "order": 0, "props": { "icon": "git-branch", "title": "Parallel review", "description": "Spawn 30 review agents per repo. Each one inspects a disjoint slice of the diff. No serial bottleneck." } },
        { "id": "f-2", "type": "feature-card", "enabled": true, "order": 1, "props": { "icon": "share-2", "title": "Dependency graphs", "description": "Walk every direct and transitive dep. Surface drift, version skew, and orphaned packages in one report." } },
        { "id": "f-3", "type": "feature-card", "enabled": true, "order": 2, "props": { "icon": "shield", "title": "Security scanning", "description": "CVE matching against the live OSV database. Severity-ranked. Linked to upstream advisories." } },
        { "id": "f-4", "type": "feature-card", "enabled": true, "order": 3, "props": { "icon": "edit-3", "title": "Batch refactor", "description": "Apply a codemod across all matched files atomically. Preview the diff before commit. No half-applied state." } },
        { "id": "f-5", "type": "feature-card", "enabled": true, "order": 4, "props": { "icon": "check-square", "title": "Lint enforcement", "description": "Wire any linter — ESLint, Ruff, golangci-lint — into the review pipeline. Failing rules block merge." } },
        { "id": "f-6", "type": "feature-card", "enabled": true, "order": 5, "props": { "icon": "rotate-ccw", "title": "Atomic rollback", "description": "Every Axon run produces a transactional snapshot. Revert the entire batch with one command." } }
      ],
      "content": { "heading": "// six things Axon does", "subheading": "Each feature was built because reviewing dependencies by hand stopped scaling at twenty repos." }
    },
    {
      "type": "text",
      "id": "code-example-01",
