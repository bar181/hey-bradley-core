    "author": "Atlas Marketplace",
    "email": "hello@atlas-agents.dev",
    "domain": "atlas-agents.dev",
    "project": "atlas-agent-marketplace",
    "version": "1.0.0",
    "spec": "aisp-1.2",
    "purpose": "saas",
    "audience": "developer",
    "tone": "technical",
    "brandName": "Atlas",
    "tagline": "Hire a specialist agent in 30 seconds",
    "voiceAttributes": ["agentic", "developer-first", "specific", "no-fluff"]
  },
