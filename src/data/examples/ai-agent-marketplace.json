        {
          "id": "subtitle",
          "type": "text",
          "enabled": true,
          "order": 2,
          "props": { "text": "Atlas is a curated marketplace of single-purpose AI agents — for code review, contract redline, SQL drafting, market research, image cleanup, and 80 other vertical tasks. Search by capability, see real benchmark scores, and call any agent through one typed SDK. Pay per task, not per seat. No vendor lock-in." }
        },
        {
          "id": "primaryCta",
          "type": "button",
          "enabled": true,
          "order": 3,
          "props": { "text": "Browse the catalog", "url": "#agents", "style": "filled", "size": "lg" }
        },
        {
          "id": "secondaryCta",
          "type": "button",
          "enabled": true,
          "order": 4,
          "props": { "text": "Read the SDK docs", "url": "#docs", "style": "outline", "size": "lg" }
