    {
      "type": "columns",
      "id": "features-01",
      "enabled": true,
      "order": 1,
      "variant": "icon-cards",
      "layout": { "display": "grid", "columns": 3, "gap": "32px", "padding": "72px 24px" },
      "style": { "background": "#141a33", "color": "#eef2ff" },
      "components": [
        {
          "id": "f-1",
          "type": "feature-card",
          "enabled": true,
          "order": 0,
          "props": {
            "icon": "search",
            "title": "Capability-tagged search",
            "description": "Every agent is tagged with verified capabilities (`code-review`, `pdf-extract`, `legal-redline`) plus benchmark scores against canonical task suites. No vague \"AI assistant\" listings — every entry declares exactly what it does and how well it does it on real evals."
          }
        },
        {
          "id": "f-2",
          "type": "feature-card",
          "enabled": true,
          "order": 1,
          "props": {
            "icon": "plug",
            "title": "One SDK, every agent",
            "description": "`atlas.invoke(agentId, payload)` works the same for all 1,200 agents. Typed inputs and outputs, automatic retries, streamed responses, and pre-flight cost estimates. Drop the SDK into your existing backend and ship today; switch agents tomorrow without touching call sites."
          }
        },
        {
          "id": "f-3",
          "type": "feature-card",
          "enabled": true,
          "order": 2,
          "props": {
            "icon": "credit-card",
            "title": "Pay per task, not per seat",
            "description": "Every agent publishes a per-call price ($0.002 to $4.50 typical range). You pay only for completed tasks — failures and timeouts are free. Bring your own LLM key on the Pro tier and the marketplace fee drops to 4%. No retainer, no minimum, no surprise overages."
          }
        }
      ],
      "content": {
        "heading": "What you actually get",
        "subheading": "A directory built for engineers, not buyers"
      }
    },
