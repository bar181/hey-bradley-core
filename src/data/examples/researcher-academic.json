      "components": [
        {
          "id": "p-1",
          "type": "blog-post",
          "enabled": true,
          "order": 0,
          "props": {
            "title": "Specification-Grounded Fine-Tuning for Code Models",
            "excerpt": "We introduce SG-FT, a fine-tuning regimen that grounds gradient updates in machine-checkable specifications rather than reference-completion loss. On HumanEval-Hard, SG-FT yields a 14.2-point pass@1 improvement over SFT baselines while reducing wall-clock training cost by 38%. Full reproduction repo at github.com/yamada-lab/sg-ft.",
            "date": "2026-04-12",
            "readTime": "ICLR 2026 · 11 pages",
            "tags": "code-models,fine-tuning,specifications"
          }
        },
        {
          "id": "p-2",
          "type": "blog-post",
          "enabled": true,
          "order": 1,
          "props": {
            "title": "Latent Routing in Mixture-of-Experts Without Auxiliary Losses",
            "excerpt": "Standard MoE routing relies on auxiliary load-balancing losses that interact poorly with downstream RL fine-tuning. We propose latent routing — an architectural change rather than a loss — that achieves comparable balance with no auxiliary term. Implementation in 240 lines of PyTorch.",
            "date": "2026-02-08",
            "readTime": "NeurIPS 2025 · 14 pages",
            "tags": "moe,architecture,routing"
          }
        },
        {
          "id": "p-3",
          "type": "blog-post",
          "enabled": true,
          "order": 2,
          "props": {
            "title": "Memory-Efficient Attention via Hierarchical Caching",
            "excerpt": "We present a single-GPU attention variant that pushes effective context to 512K tokens by hierarchical caching of intermediate keys. Empirically lossless on long-document QA and summarization. Comes with a 350-line reference kernel and a Jupyter walkthrough.",
            "date": "2025-11-22",
            "readTime": "NeurIPS 2024 · 12 pages",
            "tags": "attention,memory-efficient,long-context"
          }
        }
      ],
      "content": {
        "heading": "Recent Papers",
        "subheading": "Each one published, peer-reviewed, and shipped with runnable code"
      }
    },
