      "components": [
        {
          "id": "f1",
          "type": "feature-card",
          "enabled": true,
          "order": 0,
          "props": {
            "icon": "🎙",
            "title": "Listen mode",
            "description": "Talk through your idea. The site builds while you speak. No forms. No drag-and-drop. Just the way you'd describe it to a friend."
          }
        },
        {
          "id": "f2",
          "type": "feature-card",
          "enabled": true,
          "order": 1,
          "props": {
            "icon": "⚡",
            "title": "Real time, not rebuild",
            "description": "Surgical JSON patches, not full regeneration. Sub-second updates. Change a headline and only the headline moves."
          }
        },
        {
          "id": "f3",
          "type": "feature-card",
          "enabled": true,
          "order": 2,
          "props": {
            "icon": "📄",
            "title": "Export the spec",
            "description": "Every build produces a formally verified AISP spec. Hand it to Claude Code, Cursor, or any AI coding assistant. They read it and ship."
          }
        }
      ],
      "content": {
        "heading": "Three things most builders get wrong",
        "subheading": "And the one Hey Bradley got right"
      }
    },
    {
      "type": "numbers",
      "id": "stats-01",
      "enabled": true,
      "order": 2,
      "variant": "counters",
      "layout": {
        "display": "grid",
        "columns": 3,
        "gap": "48px",
        "padding": "96px 24px"
      },
      "style": {
        "background": "#0f0f10",
        "color": "#f5f5f4"
      },
      "components": [
        {
          "id": "n-1",
          "type": "value-prop",
          "enabled": true,
          "order": 0,
          "props": {
            "value": "92%",
            "label": "Intent preserved",
            "description": "Across five handoffs (design → ticket → code → review → ship), AISP keeps over 90% of original intent. Industry baseline: ~8%."
          }
        },
        {
          "id": "n-2",
          "type": "value-prop",
          "enabled": true,
          "order": 1,
          "props": {
            "value": "<2%",
            "label": "Spec ambiguity",
            "description": "AISP holds ambiguity below 2% per handoff. Normal software handoffs run ~40%. The math is brutal — and that's the math we beat."
          }
        },
        {
          "id": "n-3",
          "type": "value-prop",
          "enabled": true,
          "order": 2,
          "props": {
            "value": "0.8s",
            "label": "First build",
            "description": "From the moment you stop talking to the first rendered preview. JSON patches, not regeneration. The math goes one direction."
          }
        }
      ],
      "content": {
        "heading": "The numbers behind the build",
        "subheading": "Capstone research, Harvard ALM Digital Media Design — 2026"
