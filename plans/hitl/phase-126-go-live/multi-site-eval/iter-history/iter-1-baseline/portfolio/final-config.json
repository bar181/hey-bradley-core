          "enabled": true,
          "order": 2,
          "props": {
            "text": "Have a project in mind or just want to say hello? Feel free to reach out!"
          }
        },
        {
          "id": "contact-form",
          "type": "form",
          "enabled": true,
          "order": 3,
          "props": {
            "fields": [
              {
                "name": "name",
                "label": "Name",
                "type": "text",
                "placeholder": "Your Name"
              },
              {
                "name": "email",
                "label": "Email",
                "type": "email",
                "placeholder": "your.email@example.com"
              },
              {
                "name": "message",
                "label": "Message",
                "type": "textarea",
                "placeholder": "Tell me about your project..."
              }
            ],
            "submitText": "Send Message",
            "action": "/api/contact",
            "method": "POST"
          }
        }
      ],
      "content": {}
    },
