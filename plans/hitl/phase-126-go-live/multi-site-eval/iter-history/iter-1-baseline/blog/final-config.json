      ],
      "content": {
        "posts": [
          {
            "id": "post-1",
            "title": "Getting Started with React Hooks",
            "date": "2023-10-26",
            "excerpt": "A deep dive into useState and useEffect, and how they simplify component logic.",
            "image": "/images/react-hooks.jpg",
            "alt": "React Hooks code example",
            "tags": [
              "React",
              "Frontend",
              "JavaScript"
            ],
            "link": "/blog/react-hooks",
            "hookProblem": "Struggling with complex class components and state management in React?",
            "resolutionSummary": "React Hooks offer a simpler, more functional way to manage state and side effects, leading to cleaner and more reusable code."
          },
          {
            "id": "post-2",
            "title": "Introduction to Generative AI",
            "date": "2023-10-20",
            "excerpt": "Exploring the basics of AI models that create new content.",
            "image": "/images/generative-ai.jpg",
            "alt": "Abstract AI art",
            "tags": [
              "AI",
              "Machine Learning"
            ],
            "link": "/blog/generative-ai",
            "hookProblem": "Curious about AI but unsure how machines can create original content?",
            "resolutionSummary": "This article demystifies generative AI, explaining how models like GANs and Transformers produce new text, images, and more."
          },
          {
            "id": "post-3",
            "title": "Designing for Accessibility: A Checklist",
            "date": "2023-10-15",
            "excerpt": "Ensuring your website is usable by everyone, regardless of ability.",
            "image": "/images/accessibility.jpg",
            "alt": "Person using a screen reader",
            "tags": [
              "Design",
              "UX",
              "Accessibility"
            ],
            "link": "/blog/accessibility-checklist",
            "hookProblem": "Is your website unintentionally excluding users with disabilities?",
            "resolutionSummary": "Learn essential accessibility guidelines and a practical checklist to ensure your designs are inclusive and usable by everyone."
          },
          {
            "id": "post-4",
            "title": "Product-Market Fit: Finding Your Niche",
            "date": "2023-11-05",
            "excerpt": "Strategies for identifying and validating product-market fit to ensure sustainable growth.",
            "image": "/images/product-market-fit.jpg",
            "alt": "Product-market fit diagram",
            "tags": [
              "Product",
              "Strategy",
              "Startup"
            ],
            "link": "/blog/product-market-fit",
            "hookProblem": "Launching a product but not seeing the traction you expected?",
            "resolutionSummary": "Discover strategies to identify and validate product-market fit, ensuring your offering truly resonates with a specific customer segment."
          },
          {
            "id": "post-5",
            "title": "The Origin Story of Bradley AI",
            "date": "2023-11-10",
            "excerpt": "A look back at how Bradley AI came to be, from initial idea to prototype.",
            "image": "/images/bradley-ai-origin.jpg",
            "alt": "AI circuit board",
            "tags": [
              "AI",
              "Story",
              "Development"
            ],
            "link": "/blog/bradley-ai-origin",
            "hookProblem": "Ever wonder how a complex AI project goes from a spark of an idea to a functional prototype?",
            "resolutionSummary": "This post traces the development of Bradley AI, revealing the challenges and breakthroughs from concept to execution."
          },
          {
            "id": "post-6",
            "title": "Capstone Project: Building a Full-Stack E-commerce Site",
            "date": "2023-11-15",
            "excerpt": "My journey and lessons learned from developing a complete e-commerce platform.",
            "image": "/images/ecommerce-capstone.jpg",
            "alt": "E-commerce website screenshot",
            "tags": [
              "Web Development",
              "Full-Stack",
              "Project"
            ],
            "link": "/blog/ecommerce-capstone",
            "hookProblem": "Planning to build a comprehensive web application and need a roadmap for success?",
            "resolutionSummary": "Follow my journey building a full-stack e-commerce site, from technology choices to deployment, gaining insights for your own projects."
          }
        ]
      }
