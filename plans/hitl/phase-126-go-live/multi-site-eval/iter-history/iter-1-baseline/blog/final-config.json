        "minHeight": "60vh",
        "alignItems": "center",
        "justifyContent": "center"
      },
      "style": {},
      "components": [
        {
          "id": "hero-heading",
          "type": "heading",
          "enabled": true,
          "order": 1,
          "props": {
            "text": "Hey, I'm Bradley!",
            "level": "h1"
          }
        },
        {
          "id": "hero-subheading",
          "type": "text",
          "enabled": true,
          "order": 2,
          "props": {
            "text": "Welcome to my personal blog where I share thoughts on web development, AI, and design. Stay tuned for new articles!",
            "size": "lg"
          }
        },
        {
          "id": "hero-button",
          "type": "button",
          "enabled": true,
          "order": 3,
          "props": {
            "text": "Read My Latest Post",
            "link": "/blog/latest",
            "variant": "primary"
          }
        }
      ],
      "content": {}
