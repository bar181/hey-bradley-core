{
  "site": {
    "title": "Hey Bradley",
    "description": "Bradley's personal blog on web development, AI, and design."
  },
  "theme": {
    "mode": "dark",
    "palette": {
      "bgPrimary": "#121212",
      "bgSecondary": "#1e1e1e",
      "textPrimary": "#e0e0e0",
      "textSecondary": "#b0b0b0",
      "accentPrimary": "#dc143c",
      "accentSecondary": "#8b0000"
    },
    "typography": {
      "fontFamily": "Roboto, sans-serif",
      "headingFamily": "Cormorant Garamond, serif",
      "baseSize": "17px",
      "lineHeight": 1.5
    },
    "spacing": {
      "sectionPadding": "80px",
      "containerMaxWidth": "960px",
      "componentGap": "32px"
    },
    "borderRadius": "6px"
  },
  "sections": [
    {
      "type": "hero",
      "id": "hero-main",
      "enabled": true,
      "order": 1,
      "variant": "center-text",
