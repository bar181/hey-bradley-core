          "id": "author-bio-text",
          "type": "text",
          "enabled": true,
          "order": 3,
          "props": {
            "text": "Bradley Ross holds an ALM from Harvard and is a passionate web developer, AI enthusiast, and design thinker. He believes in crafting intuitive and powerful digital experiences that blend cutting-edge technology with elegant design. On this blog, he shares insights, tutorials, and personal reflections on his journey through the ever-evolving landscapes of web development, artificial intelligence, and user experience design.",
            "size": "md"
          }
        }
