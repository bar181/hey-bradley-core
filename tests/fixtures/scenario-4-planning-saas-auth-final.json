      "id": "ADR-002",
      "title": "Token Format — JWT with rotation + refresh",
      "status": "Proposed",
      "phaseId": "sessions",
      "rationale": "JWT enables stateless verification; refresh tokens enable session continuity without password re-entry."
    },
