            "subtitle": "Public, terse, semver-respecting.",
            "entries": [
              {
                "id": "v1-0-0",
                "version": "1.0.0",
                "date": "2026-04-28",
                "tag": "stable",
                "title": "Stable release",
                "body": "Type inference for nested subcommands is now exhaustive. Help screens render in <2ms even on Node 18 cold starts. No public-API changes from 0.9.x — `npm install axon@1` is a drop-in upgrade."
              },
              {
                "id": "v0-9-0",
                "version": "0.9.0",
                "date": "2026-03-15",
                "tag": "beta",
                "title": "Async validators + bun runtime",
                "body": "`.flag(name, { validate: async fn })` is supported end-to-end. Bun is now a first-class runtime in CI; everything that worked on Node 18 works on Bun 1.0+."
              },
              {
                "id": "v0-8-0",
                "version": "0.8.0",
                "date": "2026-02-02",
                "tag": "beta",
                "title": "Subcommand groups",
                "body": "`cli('git').group('remote').command('add', ...)` finally works without a custom router. The help screen groups by namespace automatically."
              },
              {
                "id": "v0-7-0",
                "version": "0.7.0",
                "date": "2026-01-10",
                "tag": "beta",
                "title": "Prompt fallback for missing required flags",
                "body": "Missing required flags now fall back to an interactive prompt when `process.stdin.isTTY` is true. Disable with `--no-prompt` or `cli().prompt(false)`."
              }
            ]
          },
