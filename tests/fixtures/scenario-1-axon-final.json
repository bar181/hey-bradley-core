      "order": 2,
      "variant": "code-steps",
      "layout": {
        "display": "grid",
        "gap": "24px",
        "padding": "96px 32px",
        "maxWidth": "1120px",
        "columns": 3
      },
      "content": {
        "title": "Quickstart",
        "subtitle": "Three commands to a fully-typed CLI.",
        "steps": [
          {
            "id": "install",
            "label": "1. Install",
            "code": "npm install axon",
            "description": "Zero peer-deps. Works with Node 18+ and Bun."
          },
          {
            "id": "define",
            "label": "2. Define",
            "code": "import { cli } from 'axon'\n\ncli('greet')\n  .arg('name', { required: true })\n  .flag('--shout', { type: 'boolean' })\n  .run(({ name, shout }) => {\n    const msg = `hi, ${name}`\n    console.log(shout ? msg.toUpperCase() : msg)\n  })",
            "description": "Type-safe args + flags. No string-bag config."
          },
          {
            "id": "ship",
            "label": "3. Ship",
            "code": "$ npx greet world --shout\n> HI, WORLD",
            "description": "Help screens generated automatically. Errors are humans-first."
          }
        ]
      },
      "style": {
        "background": "#101114",
        "color": "#f4f4f5",
        "fontFamily": "JetBrains Mono"
      },
      "components": []
